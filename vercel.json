{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/domains",
      "destination": "/api/job-roles?type=domains"
    },
    {
      "source": "/api/candidates/:id/stage",
      "destination": "/api/candidates?id=:id&action=update_stage"
    },
    {
      "source": "/api/candidates/:id",
      "destination": "/api/candidates?id=:id"
    },
    {
      "source": "/api/exam/:path*",
      "destination": "/api/exam?path=:path*"
    },
    {
      "source": "/api/exam",
      "destination": "/api/exam"
    },
    {
      "source": "/api/questions/:path*",
      "destination": "/api/exam?type=questions&path=:path*"
    },
    {
      "source": "/api/questions",
      "destination": "/api/exam?type=questions"
    },
    {
      "source": "/api/proctoring/:path*",
      "destination": "/api/exam?type=proctoring&path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth/:action"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

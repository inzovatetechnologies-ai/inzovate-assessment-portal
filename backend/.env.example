# INZOVATE TECHNOLOGIES PRIVATE LIMITED
# INZOVATE TALENT ASSESSMENT PORTAL – ENVIRONMENT CONFIGURATION TEMPLATE

# Server Port & Mode
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=inzovate-super-secret-enterprise-jwt-key-change-this-in-production-2026
JWT_EXPIRES_IN=24h

# MongoDB Atlas Database Connection
# If left empty, the application uses its built-in disk-persisted resilient data store
MONGODB_URI=mongodb+srv://inzovate_admin:<DB_PASSWORD>@inzovate-cluster.mongodb.net/inzovate_talent_assessment?retryWrites=true&w=majority

# Hostinger Domain & CORS
FRONTEND_URL=https://assessment.inzovate-technologies.com
HOSTINGER_DOMAIN=assessment.inzovate-technologies.com

# Private S3-Compatible Object Storage (Webcam Recordings & Documents)
S3_STORAGE_BUCKET=inzovate-proctoring-vault
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=ap-south-1

# Cloudflare Configuration
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Email & SMS Provider (for OTP & Notifications)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=careers@inzovate-technologies.com
SMTP_PASS=your-smtp-password
SMS_GATEWAY_API_KEY=your-sms-api-key
